--  Utility: function to compute final numeric grade per enrollment

-- Returns numeric percent grade for a given EnrollID
CREATE OR REPLACE FUNCTION fn_final_grade_for_enroll(p_enrollid INT)
RETURNS NUMERIC(6,2) LANGUAGE SQL AS $$
    SELECT COALESCE((SUM("Score" * ("Weight"/100.0)) ),0)  -- Score already 0-100, Weight is percent -> multiply
    FROM "Assessment"
    WHERE "EnrollID" = p_enrollid;
$$;

