--7.Create a view summarizing average grades per department
-- This view computes the average final numeric grade for all enrollments in courses belonging to each department.
CREATE OR REPLACE VIEW view_avg_grade_per_department AS
SELECT
    d."DeptID",
    d."DeptName",
    ROUND(AVG(finals.final_percent)::numeric,2) AS avg_final_percent
FROM "Department" d
JOIN "Course" c ON c."DeptID" = d."DeptID"
JOIN (
    SELECT e."EnrollID", e."CourseID", fn_final_grade_for_enroll(e."EnrollID") AS final_percent
    FROM "Enrollment" e
) finals ON finals."CourseID" = c."CourseID"
GROUP BY d."DeptID", d."DeptName";

