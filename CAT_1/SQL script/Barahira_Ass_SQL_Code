SELECT
    s."StudentID",
    s."FullName" AS student_name,
    c."CourseID",
    c."Title"    AS course_title,
    e."Semester",
    ROUND(fn_final_grade_for_enroll(e."EnrollID")::numeric,2) AS final_percent,
    CASE
        WHEN fn_final_grade_for_enroll(e."EnrollID") >= 85 THEN 'A'
        WHEN fn_final_grade_for_enroll(e."EnrollID") >= 70 THEN 'B'
        WHEN fn_final_grade_for_enroll(e."EnrollID") >= 60 THEN 'C'
        WHEN fn_final_grade_for_enroll(e."EnrollID") >= 50 THEN 'D'
        ELSE 'F'
    END AS letter_grade
FROM "Enrollment" e
JOIN "Student" s ON s."StudentID" = e."StudentID"
JOIN "Course" c ON c."CourseID" = e."CourseID"
WHERE e."Status" IN ('Completed','Registered')
ORDER BY s."StudentID", e."Semester", c."CourseID";

