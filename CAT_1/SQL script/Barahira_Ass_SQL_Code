-- 1. Create tables with PK, FK, NOT NULL, CHECK


-- Department table
CREATE TABLE "Department" (
    "DeptID"     SERIAL PRIMARY KEY,                -- unique department id
    "DeptName"   VARCHAR(100) NOT NULL UNIQUE,      -- department name, unique
    "Faculty"    VARCHAR(100) NOT NULL              -- faculty name
);

-- Instructor table
CREATE TABLE "Instructor" (
    "InstructorID" SERIAL PRIMARY KEY,              -- unique instructor id
    "FullName"     VARCHAR(150) NOT NULL,
    "DeptID"       INT NOT NULL REFERENCES "Department"("DeptID") ON DELETE RESTRICT,
    "Email"        VARCHAR(255) NOT NULL UNIQUE,
    "Phone"        VARCHAR(20),
    CONSTRAINT chk_instructor_email CHECK (POSITION('@' IN "Email") > 1)  -- basic email check
);
-- Course table
CREATE TABLE "Course" (
    "CourseID"     SERIAL PRIMARY KEY,
    "Title"        VARCHAR(200) NOT NULL,
    "CreditHours"  SMALLINT NOT NULL CHECK ("CreditHours" > 0 AND "CreditHours" <= 10),
    "DeptID"       INT NOT NULL REFERENCES "Department"("DeptID") ON DELETE RESTRICT,
    "InstructorID" INT NOT NULL REFERENCES "Instructor"("InstructorID") ON DELETE SET NULL
    -- Note: ON DELETE SET NULL requires InstructorID to allow NULL; since spec asked FK valid,
    -- we'll instead use ON DELETE RESTRICT to preserve referential integrity.
);
-- Correction: because ON DELETE SET NULL with NOT NULL conflicts, re-create Course with ON DELETE RESTRICT:
DROP TABLE IF EXISTS "Course";
CREATE TABLE "Course" (
    "CourseID"     SERIAL PRIMARY KEY,
    "Title"        VARCHAR(200) NOT NULL,
    "CreditHours"  SMALLINT NOT NULL CHECK ("CreditHours" > 0 AND "CreditHours" <= 10),
    "DeptID"       INT NOT NULL REFERENCES "Department"("DeptID") ON DELETE RESTRICT,
    "InstructorID" INT NOT NULL REFERENCES "Instructor"("InstructorID") ON DELETE RESTRICT
);
-- Student table
CREATE TABLE "Student" (
    "StudentID"   SERIAL PRIMARY KEY,
    "FullName"    VARCHAR(150) NOT NULL,
    "Gender"      VARCHAR(10) NOT NULL CHECK ("Gender" IN ('Male','Female','Other')),
    "Email"       VARCHAR(255) UNIQUE,
    "YearOfStudy" SMALLINT NOT NULL CHECK ("YearOfStudy" >= 1 AND "YearOfStudy" <= 8)
);
-- 2. Applying CASCADE DELETE for Enrollment–Assessment linkage.
-- Enrollment table
CREATE TABLE "Enrollment" (
    "EnrollID"   SERIAL PRIMARY KEY,
    "StudentID"  INT NOT NULL REFERENCES "Student"("StudentID") ON DELETE CASCADE,
    "CourseID"   INT NOT NULL REFERENCES "Course"("CourseID") ON DELETE RESTRICT,
    "Semester"   VARCHAR(20) NOT NULL,               -- e.g., '2025-Fall'
    "Status"     VARCHAR(20) NOT NULL CHECK ("Status" IN ('Registered','Completed','Withdrawn')),
    CONSTRAINT uc_student_course_semester UNIQUE ("StudentID","CourseID","Semester")
);
-- Assessment table (each assessment belongs to an enrollment)
CREATE TABLE "Assessment" (
    "AssessID"       SERIAL PRIMARY KEY,
    "EnrollID"       INT NOT NULL REFERENCES "Enrollment"("EnrollID") ON DELETE CASCADE, -- cascade required
    "AssessmentType" VARCHAR(50) NOT NULL,   -- e.g., 'Assignment', 'Quiz', 'Final'
    "Score"          NUMERIC(5,2) NOT NULL CHECK ("Score" >= 0 AND "Score" <= 100), -- percent
    "Weight"         NUMERIC(5,2) NOT NULL CHECK ("Weight" >= 0 AND "Weight" <= 100) -- percent weight
);
-- Table to store computed semester GPA per student (the trigger will maintain this)
CREATE TABLE "SemesterGPA" (
    "StudentID" INT NOT NULL REFERENCES "Student"("StudentID") ON DELETE CASCADE,
    "Semester"  VARCHAR(20) NOT NULL,
    "GPA"       NUMERIC(3,2) NOT NULL CHECK ("GPA" >= 0 AND "GPA" <= 4.0),
    PRIMARY KEY ("StudentID","Semester")
);

