-- Create function to compute grade point from percent
CREATE OR REPLACE FUNCTION fn_gradepoint_from_percent(p_percent NUMERIC)
RETURNS NUMERIC(3,2) AS $$
BEGIN
    IF p_percent >= 85 THEN
        RETURN 4.00;
    ELSIF p_percent >= 70 THEN
        RETURN 3.00;
    ELSIF p_percent >= 60 THEN
        RETURN 2.00;
    ELSIF p_percent >= 50 THEN
        RETURN 1.00;
    ELSE
        RETURN 0.00;
    END IF;
END;
$$ LANGUAGE plpgsql IMMUTABLE;

-- Create trigger function to recalc semester GPA
CREATE OR REPLACE FUNCTION fn_recalc_semester_gpa()
RETURNS TRIGGER AS $$
DECLARE
    v_enrollid INT;
    v_studentid INT;
    v_semester VARCHAR(20);
    v_final NUMERIC(6,2);
    v_gradepoint NUMERIC(3,2);
BEGIN
    -- Determine the affected enrollment(s). For INSERT/UPDATE, use NEW; for DELETE, use OLD.
    IF (TG_OP = 'INSERT') THEN
        v_enrollid := NEW."EnrollID";
    ELSIF (TG_OP = 'UPDATE') THEN
        -- If enrollment changed on update, recalc for both old and new enrollments
        v_enrollid := NEW."EnrollID";
    ELSE  -- DELETE
        v_enrollid := OLD."EnrollID";
    END IF;

    -- Find student and semester for this enrollment
    SELECT "StudentID", "Semester" INTO v_studentid, v_semester
    FROM "Enrollment"
    WHERE "EnrollID" = v_enrollid;

    -- If enrollment no longer exists (should not happen except on cascade delete), exit
    IF NOT FOUND THEN
        RETURN NULL;
    END IF;

    -- Recalculate GPA for that student & semester:
    -- 1) For each enrollment of that student in that semester, compute final percent
    -- 2) Map to grade point
    -- 3) Weight by course credit hours
    -- 4) Compute SUM(grade_point * credit_hours) / SUM(credit_hours)
    WITH per_enroll AS (
        SELECT e."EnrollID", e."CourseID", fn_final_grade_for_enroll(e."EnrollID") AS final_percent
        FROM "Enrollment" e
        WHERE e."StudentID" = v_studentid AND e."Semester" = v_semester
    ),
    grade_points AS (
        SELECT pe."EnrollID", pe."final_percent",
               fn_gradepoint_from_percent(pe."final_percent") AS grade_point,
               c."CreditHours"
        FROM per_enroll pe
        JOIN "Course" c ON c."CourseID" = pe."CourseID"
    )
    SELECT
        CASE WHEN SUM(grade_point * "CreditHours") IS NULL THEN 0.0
             ELSE ROUND(SUM(grade_point * "CreditHours")::numeric / NULLIF(SUM("CreditHours"),0),2)
        END
    INTO v_final
    FROM grade_points;

    -- Upsert into SemesterGPA
    INSERT INTO "SemesterGPA" ("StudentID","Semester","GPA")
    VALUES (v_studentid, v_semester, v_final)
    ON CONFLICT ("StudentID","Semester")
    DO UPDATE SET "GPA" = EXCLUDED."GPA";

    RETURN NULL; -- triggers fired AFTER, return value ignored
END;
$$ LANGUAGE plpgsql;

-- Attach trigger to Assessment table AFTER INSERT OR UPDATE OR DELETE
CREATE TRIGGER trg_recalc_gpa_after_assess_update
AFTER INSERT OR UPDATE OR DELETE ON "Assessment"
FOR EACH ROW
EXECUTE FUNCTION fn_recalc_semester_gpa();


--  Initialize SemesterGPA for existing data by simulating recalculation

DO
$$
DECLARE
    r RECORD;
BEGIN
    FOR r IN
        SELECT DISTINCT e."StudentID", e."Semester"
        FROM "Enrollment" e
    LOOP
        -- Directly compute GPA for this student and semester
        WITH per_enroll AS (
            SELECT e."EnrollID", e."CourseID",
                   fn_final_grade_for_enroll(e."EnrollID") AS final_percent
            FROM "Enrollment" e
            WHERE e."StudentID" = r."StudentID"
              AND e."Semester" = r."Semester"
        ),
        grade_points AS (
            SELECT pe."EnrollID",
                   pe."final_percent",
                   fn_gradepoint_from_percent(pe."final_percent") AS grade_point,
                   c."CreditHours"
            FROM per_enroll pe
            JOIN "Course" c ON c."CourseID" = pe."CourseID"
        ),
        calc AS (
            SELECT
                COALESCE(
                    ROUND(SUM(grade_point * "CreditHours")::numeric / NULLIF(SUM("CreditHours"),0), 2),
                    0.00
                ) AS gpa
            FROM grade_points
        )
        INSERT INTO "SemesterGPA" ("StudentID", "Semester", "GPA")
        SELECT r."StudentID", r."Semester", calc.gpa
        FROM calc
        ON CONFLICT ("StudentID","Semester")
        DO UPDATE SET "GPA" = EXCLUDED."GPA";
    END LOOP;
END
$$ LANGUAGE plpgsql;


